# FinShield AI — backend configuration for running outside Docker
# (uvicorn app.main:app --port 8091). Copy to backend/.env (git-ignored).

# Required outside APP_ENV=test: the app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Primary database: PostgreSQL (required; SQLite is test-only). With the compose postgres
# running (`docker compose up -d postgres`, bound to 127.0.0.1:5432), use your POSTGRES_* values,
# then run `alembic upgrade head` once before starting uvicorn.
DATABASE_URL=postgresql://finshield:<POSTGRES_PASSWORD>@localhost:5432/finshield

# RAG store: pgvector Postgres. Leave unset to run with RAG disabled. With the
# compose postgres running (bound to 127.0.0.1:5432), use your POSTGRES_* values:
# RAG_DATABASE_URL=postgresql://finshield:<POSTGRES_PASSWORD>@localhost:5432/finshield

# Semantic embeddings need sentence-transformers, which is not installed yet
# (slice S2.4). Keep false; the hashing embedder is used.
RAG_USE_SENTENCE_TRANSFORMERS=false

# Only used in the startup log line; the port is set on the uvicorn command line.
APP_PORT=8091

# Not yet configurable (hardcoded; runtime config is slice S1.4): JWT algorithm
# (HS256), token lifetime (24h), rate limits, signup credits.
