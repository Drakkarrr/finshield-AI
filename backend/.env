# FinShield AI — Environment Configuration
# Copy this file to .env and update values for your environment.

# Application
APP_ENV=development
DEBUG=true
APP_PORT=8091

# Database
DATABASE_URL=sqlite:///./finshield.db

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8090

# Credits
DEFAULT_SIGNUP_CREDITS=50000
