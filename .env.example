# FinShield AI — docker compose configuration
# Copy to .env (git-ignored) and fill in the two required secrets below.
# `docker compose up` refuses to start while a required value is empty.

# --- Required -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Master key for pseudonymisation, column encryption and audit-export signing (>= 32 chars).
# Same generator. Losing it makes encrypted columns unreadable and changes pseudonyms: back it up.
DATA_ENCRYPTION_KEY=
# Postgres password (pgvector / RAG store). Use URL-safe characters: compose
# embeds it in the RAG connection string.
POSTGRES_PASSWORD=

# --- Optional (defaults shown) --------------------------------------------
POSTGRES_USER=finshield
POSTGRES_DB=finshield
CORS_ORIGINS=http://localhost:3000
DEBUG=false
# RAG embeddings: minilm (semantic, baked into the image) or hash (lexical fallback)
RAG_EMBEDDER=minilm
# First boot: download the official OFAC SDN list; load the FICTIONAL demo PEP fixture.
# Set LISTS_DEMO_FIXTURES=false in production and import a licensed PEP source instead.
LISTS_AUTO_DOWNLOAD=true
LISTS_DEMO_FIXTURES=true

# Observability (optional). METRICS_TOKEN enables /metrics as a bearer-token endpoint.
METRICS_TOKEN=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# DATABASE_URL and RAG_DATABASE_URL are set by docker-compose.yml from the
# values above. To run the backend outside Docker, use backend/.env.example.

# Not yet configurable (hardcoded in backend/app/auth.py and main.py; runtime
# config is roadmap slice S1.4): JWT algorithm (HS256), token lifetime (24h),
# rate limits (5/min register, 10/min login, 60/min screening), signup credits.

# Backups (S4.5). Archives are written to BACKUP_HOST_DIR on the host.
BACKUP_HOST_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=35
BACKUP_MIN_KEEP=7

# Browser session and transport security (D11, S6.2). Set both to true when served over HTTPS.
COOKIE_SECURE=false
HSTS_ENABLED=false

# Payments (S6.1). "simulated" adds credits without any payment: development only.
# For Stripe test mode: PAYMENTS_MODE=stripe plus the test keys from the Stripe dashboard, and point
# a webhook (checkout.session.completed, checkout.session.expired) at /api/v1/billing/webhooks/stripe.
PAYMENTS_MODE=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000

# Screening rate limit per credential (API key or session), slowapi syntax.
SCREENING_RATE_LIMIT=60/minute
